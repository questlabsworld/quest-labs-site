      .home-who__photo { width: 120px; height: 120px; }
      .ql-fold__title { font-size: 1.2rem; }
    }

    /* ── PROGRAM ── */
    .prog-ways-top { padding-top: 3rem !important; padding-bottom: 3rem !important; }
    .prog-ways-top .prog-doors { max-width: 1060px; margin-top: 0; }
    .prog-doors-list.prog-ways-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: stretch; }
    .prog-ways-cards > li { flex-direction: column; gap: 0.75rem; background: rgba(107,63,160,0.06); border: 0.5px solid rgba(180,143,224,0.35); border-radius: 12px; padding: 1.4rem 1.25rem; }
    .prog-ways-cards .prog-zine-form-row .prog-waitlist-input { flex-basis: 100%; }
    .prog-seat-fold { margin: 0.5rem 0 0; max-width: none; }
    .prog-seat-fold > summary { justify-content: flex-start; }
    .prog-seat-fold .ql-fold__title { font-size: 1.15rem; }
    @media (max-width: 900px) { .prog-doors-list.prog-ways-cards { grid-template-columns: minmax(0, 1fr); } }
    .prog-ways-cards > li { padding: 0 !important; background: none !important; border: none !important; }
    .prog-way { margin-top: 0; height: 100%; }
    .prog-way > summary { justify-content: flex-start; gap: 0.75rem; }
    .prog-way > summary::after { margin-left: auto; }
