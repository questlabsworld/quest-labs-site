    .seedend__link { display: inline-flex; flex-direction: column; align-items: center; gap: 0.9rem; text-decoration: none; color: var(--text); }
    .seedend__img { width: 92px; height: auto; transition: transform 0.3s ease; }
    .seedend__link:hover .seedend__img { transform: translateY(-4px) rotate(-4deg); }
    .seedend__line { display: block; font-family: 'Cormorant Garamond', serif; font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.3; color: var(--text-dim); font-style: italic; }
    .seedend__line--cta { color: #C4A8E8; font-style: normal; }
    .seedend__link:hover .seedend__line--cta { text-decoration: underline; text-underline-offset: 5px; }
    .seedend__link:focus-visible { outline: 2px solid #B48FE0; outline-offset: 6px; border-radius: 8px; }
  </style>
  {goatcounterCode && <script is:inline data-goatcounter={`https://${goatcounterCode}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>}
</head>
<body>
  <canvas id="starfield"></canvas>

  <nav class="site-nav">
    <div class="site-nav__brand">
      <a href="/"><img src="/images/logo/quest-labs-logo.png" alt="Quest Labs — go to homepage" class="site-nav__logo" /></a>
    </div>

    <button class="site-nav__burger" id="navBurger" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="site-nav__links" id="navLinks">
      {navLinks.map(l => (
        <li class:list={['site-nav__item', { 'has-dropdown': l.dropdown }]}>
          <a
            href={l.href}
            class:list={['site-nav__link', { 'site-nav__link--active': isActive(l.href, l.dropdown) }]}
            aria-current={isActive(l.href, l.dropdown) ? 'page' : undefined}
          >
            {l.label}
            {isActive(l.href, l.dropdown) && <span class="site-nav__dot" aria-hidden="true" />}
          </a>
          {l.dropdown && (
            <ul class="site-nav__dropdown">
              {l.dropdown.map((d: { label: string; href: string }) => (
                <li>
                  <a
                    href={d.href}
                    class:list={['site-nav__dropdown-link', { 'site-nav__link--active': isActive(d.href) }]}
                    aria-current={isActive(d.href) ? 'page' : undefined}
                  >
                    {d.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>

  {showBanner && <a href="/black-menagerie/play" class="presale-banner"><span aria-hidden="true">🪼</span> Play around first. <b>Draw a card →</b></a>}
  {!showBanner && <div class="presale-banner-gap" aria-hidden="true"></div>}
  <style>
    .presale-banner { position: relative; z-index: 2; display: block; text-align: center; padding: 0.6rem 1rem; background: linear-gradient(90deg, rgba(107,63,160,0.35), rgba(122,82,199,0.5), rgba(107,63,160,0.35)); border-bottom: 0.5px solid rgba(196,168,232,0.35); color: #f0ecf8; font-family: 'Space Mono', monospace; font-size: 0.8rem; letter-spacing: 0.06em; text-decoration: none; margin-bottom: 2.5rem; }
    .presale-banner b { color: #E8D9FF; font-weight: 700; }
    .presale-banner:hover b { text-decoration: underline; text-underline-offset: 3px; }
    .presale-banner-gap { height: 2.5rem; }
  </style>
  <slot />
  <div class="whisper-strip">
    <button type="button" class="whisper-env" id="whisperEnv">✉ Open a whisper from Viola</button>
    <p class="whisper-text" id="whisperText" hidden></p>
    <a class="whisper-src" id="whisperSrc" hidden href="https://schaltzeit.com/black-menagerie-interview-makeda-gershenson/" target="_blank" rel="noopener noreferrer">from Makēda's interview with Schaltzeit ↗</a>
  </div>
  <div class="viola-door" id="violaDoor">
    <div class="viola-door__menu" id="violaMenu" hidden>
      <p class="viola-door__hi">Need a door?</p>
      <a href="/black-menagerie/play">Try a signal</a>
      <a href="https://lu.ma/questlabs" target="_blank" rel="noopener noreferrer">Find a Sandbox Session</a>
      <a href="/black-menagerie#presale">Take the Menagerie home</a>
    </div>
    <button type="button" class="viola-door__btn" id="violaBtn" aria-expanded="false" aria-controls="violaMenu" aria-label="Viola Ion: need a door?">
      <img src="/images/viola/viola-ion.webp" alt="" width="600" height="659" />
    </button>
  </div>
  <style>
    .whisper-strip { position: relative; z-index: 1; text-align: center; padding: 1.5rem 1rem 0; }
    .whisper-env { background: #1a1526; border: 1px dashed #F0B47A; color: #F0B47A; border-radius: 10px; padding: 0.6rem 1.1rem; font-family: 'Special Elite', 'Courier New', monospace; font-size: 1rem; cursor: pointer; }
    .whisper-env:hover { background: #231c33; }
    .whisper-text { font-family: 'Special Elite', 'Courier New', monospace; font-size: 1.15rem; color: #f0ecf8; max-width: 560px; margin: 0.9rem auto 0.3rem; line-height: 1.5; white-space: pre-line; }
    .whisper-text[hidden], .whisper-src[hidden] { display: none; }
    .whisper-src { display: inline-block; font-family: 'Space Mono', monospace; font-size: 0.7rem; color: #B48FE0; text-decoration: none; }
    .whisper-src:hover { text-decoration: underline; }
    .viola-door { position: fixed; right: 18px; bottom: 18px; z-index: 8000; display: flex; flex-direction: column; align-items: flex-end; gap: 0.6rem; }
    .viola-door__btn { width: 60px; height: 60px; border-radius: 50%; padding: 0; overflow: hidden; background: #fff; border: 2px solid #B48FE0; box-shadow: 0 0 0 6px rgba(180,143,224,0.15), 0 8px 24px rgba(0,0,0,0.4); cursor: pointer; }
    .viola-door__btn img { width: 100%; height: 100%; object-fit: cover; object-position: center 15%; transform: scale(1.5); transform-origin: center 20%; }
    .viola-door__menu { background: #1a1526; border: 1px solid #B48FE0; border-radius: 14px; padding: 0.9rem 1rem; display: flex; flex-direction: column; gap: 0.45rem; min-width: 220px; box-shadow: 0 12px 30px rgba(0,0,0,0.45); }
    .viola-door__menu[hidden] { display: none; }
    .viola-door__hi { font-family: 'Special Elite', 'Courier New', monospace; font-size: 1.05rem; color: #f0ecf8; margin: 0 0 0.2rem; }
    .viola-door__menu a { font-family: 'Space Mono', monospace; font-size: 0.8rem; color: #E8D9FF; text-decoration: none; }
    .viola-door__menu a:hover { text-decoration: underline; text-underline-offset: 3px; }
    @media (max-width: 600px) { .viola-door__btn { width: 52px; height: 52px; } }
  </style>
  <script is:inline>
    (() => {
      const btn = document.getElementById('violaBtn'), menu = document.getElementById('violaMenu');
      btn.addEventListener('click', () => { menu.hidden = !menu.hidden; btn.setAttribute('aria-expanded', String(!menu.hidden)); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); } });
      const whispers = ["Both seeds and stars begin in the dark.","I see joy as a technology, an anticipatory technology.","The least-picked future is the one we need to practice imagining.","In a world that wants me to hustle and grind, I want to dance and I want to sleep.","Joy is justice.","The quest is to always question.","I want to be nimble enough to dance with whatever comes next.","My felt sense is a signal, a form of futures intelligence we've barely begun to value.","The body is a vessel, both a prototype and an archive of possibilities.","I'd rather plant or tend to the future than use it.","We are earth seed. We are star seed.","Our conditions are serious. That's precisely why we need to play.","Everything needed for change is already here.","What a society forgets shapes which futures it can imagine.","What if dark doesn't mean negative or bad?","The Black Menagerie are companions. A zoo collects and cages. This menagerie travels with you."];
      const env = document.getElementById('whisperEnv'), txt = document.getElementById('whisperText'), src = document.getElementById('whisperSrc');
      let last = -1;
      env.addEventListener('click', () => {
        let i; do { i = Math.floor(Math.random() * whispers.length); } while (i === last);
        last = i; txt.textContent = '"' + whispers[i].replace(/([.?!]) /g, '$1\n') + '"'; txt.hidden = false; src.hidden = false; env.textContent = '✉ Another whisper';
      });
    })();
  </script>
  <div class="follow-strip">
    Follow the conversation: <a href="https://www.instagram.com/questlabs.world" target="_blank" rel="noopener noreferrer">Instagram</a> · <a href="https://www.linkedin.com/company/quest-labs-education/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
  </div>
  <style>
    .follow-strip { position: relative; z-index: 1; text-align: center; padding: 1rem 1rem 1.5rem; font-family: 'Space Mono', monospace; font-size: 0.75rem; letter-spacing: 0.08em; color: var(--text-faint, rgba(240,236,248,0.5)); }
    .follow-strip a { color: var(--violet-light, #C4A8E8); text-decoration: none; }
    .follow-strip a:hover { text-decoration: underline; text-underline-offset: 3px; }
  </style>

  <script is:inline>
    // Burger menu
    const burger   = document.getElementById('navBurger');
    const navLinks = document.getElementById('navLinks');
    burger.addEventListener('click', () => {
      const open = navLinks.classList.toggle('open');
      burger.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open);
    });
    navLinks.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        navLinks.classList.remove('open');
        burger.classList.remove('open');
        burger.setAttribute('aria-expanded', false);
      });
    });

    // Starfield — skipped entirely if user prefers reduced motion
    const canvas = document.getElementById('starfield');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const ctx = canvas.getContext('2d');
      let stars = [];
      function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
      function initStars() {
        stars = [];
        for (let i = 0; i < 200; i++) {
          stars.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            r: Math.random() * 1.4 + 0.2,
            opacity: Math.random() * 0.6 + 0.1,
            speed: Math.random() * 0.3 + 0.05,
            twinkle: Math.random() * Math.PI * 2,
          });
        }
      }
      function drawStars() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        stars.forEach(s => {
          s.twinkle += 0.012;
          const o = s.opacity * (0.7 + 0.3 * Math.sin(s.twinkle));
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(240,220,160,${o})`;
          ctx.fill();
          s.y -= s.speed;
          if (s.y < -5) { s.y = canvas.height + 5; s.x = Math.random() * canvas.width; }
        });
        requestAnimationFrame(drawStars);
      }
      window.addEventListener('resize', () => { resizeCanvas(); initStars(); });
      resizeCanvas(); initStars(); drawStars();
    }
  </script>
</body>
</html>
