    @media (max-width: 640px) { .bm-later-grid { grid-template-columns: minmax(0, 1fr) !important; } }
    .pl-home { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; margin: 1.25rem 0; padding: 1.25rem 1rem; border: 1px solid #B48FE0; border-radius: 14px; background: rgba(107,63,160,0.18); }
    .pl-home[hidden] { display: none; }
    .pl-home__main { font-family: 'Special Elite', 'Courier New', monospace; font-size: 1.2rem; color: #E8D9FF; text-decoration: none; text-align: center; }
    .pl-home__main b { font-weight: 400; color: #fff; }
    .pl-home__alt { font-family: 'Space Mono', monospace; font-size: 0.8rem; letter-spacing: 0.06em; color: #C4A8E8; text-decoration: none; }
    .pl-home__main:hover, .pl-home__alt:hover { text-decoration: underline; text-underline-offset: 4px; }

    /* ── SEED BLOCK (end of page) ── */
