<script is:inline>
  async function handleSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('submit-btn');
    const msg = document.getElementById('signup-msg');
    btn.textContent = 'Sending…';
    btn.disabled = true;
    try {
      await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(e.target)).toString()
      });
      btn.textContent = '✦ Received';
      msg.textContent = 'You\'re on the list. We\'ll be in touch before Fall 2026.';
      msg.style.color = 'var(--edu-lavender)';
    } catch (err) {
      btn.textContent = 'Raise My Hand →';
      btn.disabled = false;
      msg.textContent = 'Something went wrong. Try again or email questlabs.world@proton.me directly.';
    }
  }

  function toggleAccordion(trigger) {
    const content = trigger.nextElementSibling;
    const icon = trigger.querySelector('.accordion-icon');
    const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
    trigger.setAttribute('aria-expanded', !isExpanded);
    if (isExpanded) {
      content.hidden = true;
      icon.textContent = '+';
    } else {
      content.hidden = false;
      icon.textContent = '−';
    }
  }

</script>

<style is:global>
  /* =========================================================
     EDUCATORS PAGE: scoped under .edu-page using CSS nesting
  ========================================================= */

  .edu-page {
    --edu-void: #0a0a0f;
    --edu-void2: #111118;
    --edu-violet: #6B3FA0;
    --edu-violet-mid: #8B5CC8;
    --edu-violet-light: #B48FE0;
    --edu-lavender: #C4A8E8;
    --edu-mist: #E8E4F2;
    --edu-cream: #FDFCFA;
    --edu-text-primary: #FDFCFA;
    --edu-text-muted: #9A90B8;
    --edu-text-dim: #5C5578;
    --edu-border: rgba(107,63,160,0.2);
    --edu-border-soft: rgba(255,255,255,0.06);

    font-family: 'Mulish', 'Inter', sans-serif;
    color: var(--edu-text-primary);
    line-height: 1.7;
    font-size: 18px;
    font-weight: 400;

    /* LAYOUT */
    & .container { max-width: 860px; margin: 0 auto; padding: 0 2.5rem; }
    & .container-wide { max-width: 1080px; margin: 0 auto; padding: 0 2.5rem; }

    /* HERO */
    & .hero {
      padding: 5rem 0 5rem;
      position: relative;
      overflow: hidden;
    }
    & .hero::before {
      content: '';
      position: absolute;
      top: -80px; right: -100px;
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(107,63,160,0.18) 0%, transparent 65%);
      pointer-events: none;
      z-index: 0;
    }
    & .hero > * { position: relative; z-index: 1; }
    & .hero-eyebrow {
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--edu-violet-light);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    & .hero-eyebrow::before {
      content: '◎';
      font-size: 14px;
      color: var(--edu-violet-mid);
    }
    & .hero h1 {
      font-family: 'Cinzel', serif;
      font-size: clamp(2.8rem, 6vw, 4.5rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: 0.04em;
      color: var(--edu-cream);
      margin-bottom: 1.25rem;
    }
    & .hero h1 em {
      font-style: italic;
      color: var(--edu-lavender);
    }
    & .hero-flip {
      font-family: 'Cinzel', serif;
      font-size: clamp(4rem, 14vw, 9rem) !important;
      font-weight: 700 !important;
      letter-spacing: 0.18em !important;
      color: var(--edu-cream) !important;
      line-height: 1 !important;
      margin-bottom: 0.5rem !important;
    }
    & .hero-program-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.1rem, 2.5vw, 1.5rem);
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--edu-text-muted);
      margin-bottom: 2rem;
      line-height: 1.4;
    }
    & .hero-program-name em {
      font-style: normal;
      color: var(--edu-lavender);
    }
    & .hero-sub {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.1rem, 2.5vw, 1.4rem);
      font-style: italic;
      color: var(--edu-text-muted);
      max-width: 560px;
      margin-bottom: 2.5rem;
      line-height: 1.5;
    }
    & .hero-stats {
      display: flex;
      gap: 2.5rem;
      flex-wrap: wrap;
      margin-bottom: 3rem;
    }
    & .stat-num {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.2rem;
      font-weight: 400;
      color: var(--edu-lavender);
      line-height: 1;
      display: block;
    }
    & .stat-label {
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--edu-text-dim);
    }
    & .cta-group {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      align-items: flex-start;
    }
    & .cta-with-note {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    & .cta-micro-note {
      font-family: 'Space Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      color: rgba(196, 168, 232, 0.55);
      text-transform: lowercase;
      padding-left: 0.25rem;
    }
    & .hero-onepager {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-top: 1.25rem;
      flex-wrap: wrap;
    }
    & .hero-onepager__link {
      font-family: 'Space Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--edu-violet-mid);
      text-decoration: none;
      transition: color 0.2s;
    }
    & .hero-onepager__link:hover { color: var(--edu-lavender); }
    & .hero-onepager__note {
      font-size: 0.82rem;
      font-style: italic;
      color: var(--edu-text-dim);
    }

    & .hero-credential {
      font-family: 'Space Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: rgba(180, 143, 224, 0.6);
      line-height: 1.7;
      max-width: 580px;
      margin-bottom: 1.5rem;
      border-left: 2px solid rgba(107, 63, 160, 0.4);
      padding-left: 1rem;
    }
    & .field-credential {
      font-family: 'Space Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: rgba(180, 143, 224, 0.6);
      line-height: 1.7;
      max-width: 580px;
      margin-bottom: 2rem;
      border-left: 2px solid rgba(107, 63, 160, 0.4);
      padding-left: 1rem;
    }

    /* BUTTONS */
    & .btn {
      display: inline-block;
      font-size: 13px;
      font-weight: 500;
      padding: 0.75rem 1.75rem;
      border-radius: 2px;
      text-decoration: none;
      transition: all 0.2s;
      letter-spacing: 0.04em;
      cursor: pointer;
      border: none;
      font-family: 'Inter', sans-serif;
    }
    & .btn-primary {
      background: var(--edu-violet);
      color: var(--edu-cream);
    }
    & .btn-primary:hover { background: var(--edu-violet-mid); }
    & .btn-ghost {
      background: transparent;
      color: var(--edu-lavender);
      border: 0.5px solid rgba(180,143,224,0.4);
    }
    & .btn-ghost:hover {
      background: rgba(107,63,160,0.1);
      border-color: var(--edu-lavender);
    }

    /* DIVIDER */
    & .divider {
      width: 100%;
      height: 0.5px;
      background: var(--edu-border);
      margin: 0;
    }

    /* SECTIONS */
    & section { padding: 5rem 0; }
    & section + section { border-top: 0.5px solid var(--edu-border-soft); }

    & .section-tag {
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--edu-violet-light);
      margin-bottom: 0.75rem;
    }

    & h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 500;
      line-height: 1.15;
      color: var(--edu-cream);
      margin-bottom: 1.5rem;
    }
    & h2 em { font-style: italic; color: var(--edu-lavender); }

    & h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.35rem;
      font-weight: 500;
      color: var(--edu-text-primary);
      margin-bottom: 0.5rem;
    }
    & h3.subhead {
      font-size: 1.6rem;
      margin-bottom: 1rem;
    }

    & p {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem;
      font-weight: 400;
      line-height: 1.85;
      color: rgba(253,252,250,0.82);
      margin-bottom: 1rem;
      max-width: 620px;
    }
    & p strong { font-weight: 500; color: var(--edu-cream); }

    & .inline-link {
      color: var(--edu-violet-light);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s, color 0.2s;
    }
    & .inline-link:hover {
      color: var(--edu-lavender);
      border-bottom-color: currentColor;
    }

    & .inline-blurb {
      max-width: 620px;
      font-size: 1rem;
      color: rgba(253,252,250,0.78);
      margin-bottom: 0.75rem;
      line-height: 1.8;
    }

    & .role-list {
      max-width: 620px;
    }

    /* PULL QUOTE (inline) */
    & .pull {
      border-left: 2px solid var(--edu-violet);
      padding: 1rem 1.5rem;
      margin: 2.5rem 0;
      background: rgba(107,63,160,0.06);
    }
    & .pull p {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.25rem;
      font-style: italic;
      color: var(--edu-lavender);
      margin: 0;
      max-width: 100%;
      line-height: 1.5;
    }

    /* PULL QUOTE: standalone centred Beat 1 moment */
    & .pull-quote-section {
      padding: 4rem 0;
      background: rgba(107,63,160,0.04);
      border-top: 0.5px solid var(--edu-border-soft);
      border-bottom: 0.5px solid var(--edu-border-soft);
    }
    & .pull-quote-solo {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.35rem, 3vw, 2rem);
      font-style: italic;
      font-weight: 400;
      color: var(--edu-cream);
      line-height: 1.5;
      text-align: center;
      max-width: 680px;
      margin: 0 auto;
      padding: 0 2.5rem;
      border: none;
      position: relative;
    }
    & .pull-quote-solo::before {
      content: '"';
      font-family: 'Cormorant Garamond', serif;
      font-size: 5rem;
      color: rgba(107,63,160,0.3);
      position: absolute;
      top: -1.5rem;
      left: 1.5rem;
      line-height: 1;
    }

    /* THE MIRROR COLUMNS */
    & .problem-cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      border: 0.5px solid var(--edu-border);
      margin: 2rem 0;
    }
    & .prob-col {
      padding: 1.75rem;
      background: var(--edu-void2);
    }
    & .prob-col:first-child { border-right: 0.5px solid var(--edu-border); }
    & .prob-col h4 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.15rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      text-transform: none;
      color: var(--edu-text-dim);
      margin-bottom: 1rem;
    }
    & .prob-col ul { list-style: none; padding: 0; }
    & .prob-col ul li {
      font-size: 1rem;
      font-weight: 300;
      color: rgba(253,252,250,0.65);
      padding: 0.5rem 0;
      border-bottom: 0.5px solid var(--edu-border-soft);
      line-height: 1.6;
    }
    & .prob-col ul li:last-child { border-bottom: none; }
    & .prob-col ul li::before { content: '- '; color: var(--edu-text-dim); }
    & .prob-col.bright h4 { color: var(--edu-lavender); }
    & .prob-col.bright ul li { color: rgba(253,252,250,0.85); }
    & .prob-col.bright ul li::before { color: var(--edu-violet-mid); }

    /* WHO LIST */
    & .who-list {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin: 2rem 0;
      border: 0.5px solid var(--edu-border);
    }
    & .who-row {
      display: grid;
      grid-template-columns: 180px 1fr;
      border-bottom: 0.5px solid var(--edu-border-soft);
      transition: background 0.35s ease, box-shadow 0.35s ease;
    }
    & .who-row:last-child { border-bottom: none; }
    & .who-list--archetypes .who-row:hover {
      background: rgba(196, 168, 232, 0.06);
      box-shadow: inset 0 0 0 1px rgba(196, 168, 232, 0.35), 0 0 24px rgba(139, 92, 200, 0.18);
    }
    & .who-label {
      padding: 1.25rem 1.5rem;
      border-right: 0.5px solid var(--edu-border);
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.15rem;
      font-style: italic;
      color: var(--edu-lavender);
      display: flex;
      align-items: center;
    }
    & .who-text {
      padding: 1.25rem 1.5rem;
      font-size: 1rem;
      font-weight: 300;
      color: rgba(253,252,250,0.78);
      line-height: 1.75;
    }

    /* SESSION ARC */
    & .session-arc {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 10px;
      margin: 2rem 0;
    }
    & .arc-step {
      background: var(--edu-void2);
      border: 0.5px solid var(--edu-border);
      padding: 1.25rem 1rem;
    }
    & .arc-num {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.75rem;
      color: var(--edu-text-dim);
      line-height: 1;
      margin-bottom: 0.5rem;
    }
    & .arc-step h4 {
      font-size: 13px;
      font-weight: 500;
      color: var(--edu-cream);
      margin-bottom: 0.35rem;
    }
    & .arc-step p {
      font-size: 13px;
      color: var(--edu-text-muted);
      line-height: 1.5;
      margin: 0;
      max-width: 100%;
    }

    /* NORMS */
    & .norms {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 2rem 0;
    }
    & .norm {
      background: var(--edu-void2);
      border-left: 2px solid var(--edu-violet);
      padding: 1rem 1.25rem;
    }
    & .norm h4 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      text-transform: none;
      color: var(--edu-lavender);
      margin-bottom: 0.4rem;
    }
    & .norm p {
      font-size: 1rem;
      font-weight: 300;
      color: rgba(253,252,250,0.75);
      line-height: 1.7;
      margin: 0;
      max-width: 100%;
    }

    /* 12-WEEK ARC */
    & .arc-phases { display: flex; flex-direction: column; gap: 2.5rem; margin: 2.5rem 0; }
    & .arc-phase { border-left: 2px solid rgba(255,255,255,0.1); padding-left: 1.5rem; }
    & .arc-phase--cross { border-color: var(--edu-violet); }
    & .arc-phase--emerge { border-color: var(--edu-lavender); }
    & .arc-phase--return { border-color: var(--edu-sage, #9FE1CB); }
    & .arc-phase-label {
      font-size: 0.6rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(255,255,255,0.4); margin-bottom: 0.35rem;
    }
    & .arc-phase--cross .arc-phase-label { color: var(--edu-violet); }
    & .arc-phase--emerge .arc-phase-label { color: var(--edu-lavender); }
    & .arc-phase--return .arc-phase-label { color: var(--edu-sage, #9FE1CB); }
    & .arc-phase-desc { font-size: 0.85rem; color: rgba(253,252,250,0.5); margin: 0 0 1.25rem; font-style: italic; line-height: 1.6; }
    & .arc-weeks { display: flex; flex-direction: column; gap: 0.6rem; }
    & .arc-week {
      display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; align-items: start;
      background: var(--edu-void2); border-radius: 8px; padding: 0.9rem 1rem;
      border: 1px solid rgba(255,255,255,0.05);
    }
    & .arc-week--mid { border-color: var(--edu-violet); background: rgba(123,63,158,0.1); }
    & .arc-week--final { border-color: var(--edu-lavender); background: rgba(175,169,236,0.08); }
    & .arc-week-num {
      font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; font-weight: 300;
      color: rgba(255,255,255,0.25); line-height: 1; padding-top: 0.15rem;
    }
    & .arc-week--mid .arc-week-num, & .arc-week--final .arc-week-num { color: var(--edu-lavender); }
    & .arc-week-body { display: flex; flex-direction: column; gap: 0.25rem; }
    & .arc-week-theme { font-size: 0.92rem; font-weight: 600; color: #fff; line-height: 1.3; }
    & .arc-week-journey {
      font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--edu-violet); margin-bottom: 0.15rem;
    }
    & .arc-phase--emerge .arc-week-journey { color: var(--edu-lavender); }
    & .arc-phase-desc { font-weight: 400; font-style: italic; opacity: 0.7; }
    & .arc-phase--return .arc-week-journey { color: var(--edu-sage, #9FE1CB); }
    & .arc-week-note { font-size: 0.8rem; color: rgba(253,252,250,0.6); line-height: 1.6; }
    & .arc-week-classroom { font-size: 0.78rem; color: var(--edu-lavender); line-height: 1.5; font-style: italic; margin-top: 0.15rem; }
    & .arc-week-meta { font-size: 0.7rem; color: rgba(253,252,250,0.3); margin-top: 0.2rem; }
    & .arc-bridge { font-size: 1rem; color: var(--edu-text-muted); font-style: italic; margin-bottom: 2rem; }
    & .arc-declaration {
      background: rgba(175,169,236,0.07); border: 1px solid rgba(175,169,236,0.2);
      border-radius: 10px; padding: 1.25rem 1.4rem; margin-top: 1rem; text-align: center;
    }
    & .arc-dec-label {
      font-size: 0.6rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
      color: rgba(255,255,255,0.35); margin-bottom: 0.6rem;
    }
    & .arc-dec-text {
      font-family: 'Cormorant Garamond', serif; font-size: 1.05rem; color: rgba(253,252,250,0.75);
      line-height: 1.7; font-style: italic;
    }
    & .arc-dec-text em { color: var(--edu-lavender); font-style: italic; }

    /* INVESTMENT TIERS */
    & .tier-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin: 2.5rem 0 1.5rem;
    }
    & .tier-card {
      background: var(--edu-void2);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 1.5rem 1.4rem 1.6rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    & .tier-card--mid {
      border-color: var(--edu-violet);
    }
    & .tier-card--full {
      border-color: var(--edu-lavender);
      background: rgba(175,169,236,0.06);
    }
    & .tier-eyebrow {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--edu-violet);
    }
    & .tier-card--full .tier-eyebrow { color: var(--edu-lavender); }
    & .tier-emoji { font-size: 1.6rem; line-height: 1; }
    & .tier-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.35rem;
      font-weight: 600;
      color: #fff;
      margin: 0;
    }
    & .tier-desc {
      font-size: 0.88rem;
      line-height: 1.7;
      color: rgba(253,252,250,0.72);
      margin: 0;
    }
    & .tier-desc a { color: var(--edu-violet); text-decoration: underline; text-underline-offset: 2px; }
    & .tier-for {
      font-size: 0.82rem;
      line-height: 1.6;
      color: rgba(253,252,250,0.55);
      margin: 0;
    }
    & .tier-outcomes {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      padding: 0;
      margin: 0;
    }
    & .tier-outcomes li {
      font-size: 0.8rem;
      color: rgba(253,252,250,0.65);
      padding-left: 1rem;
      position: relative;
      line-height: 1.5;
    }
    & .tier-outcomes li::before {
      content: '✦';
      position: absolute;
      left: 0;
      color: var(--edu-lavender);
      font-size: 0.6rem;
      top: 0.2rem;
    }
    & .tier-price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--edu-lavender);
      margin-top: auto;
      padding-top: 0.5rem;
    }
    & .tier-scale {
      display: flex;
      flex-direction: column;
      gap: 0;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 6px;
      overflow: hidden;
      margin-top: auto;
    }
    & .tier-scale-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 0.9rem;
      gap: 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    & .tier-scale-row:last-child { border-bottom: none; }
    & .tier-scale-support { background: rgba(255,255,255,0.03); }
    & .tier-scale-standard { background: rgba(107,63,160,0.12); }
    & .tier-scale-forward { background: rgba(175,169,236,0.1); }
    & .tier-scale-price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.35rem;
      font-weight: 400;
      color: var(--edu-lavender);
      line-height: 1;
      white-space: nowrap;
    }
    & .tier-scale-support .tier-scale-price { color: rgba(253,252,250,0.5); font-size: 1.1rem; }
    & .tier-scale-forward .tier-scale-price { color: var(--edu-lavender); }
    & .tier-scale-label {
      font-size: 0.72rem;
      color: rgba(253,252,250,0.5);
      text-align: right;
      line-height: 1.4;
    }
    & .tier-scale-standard .tier-scale-label { color: rgba(253,252,250,0.75); }
    & .witness-note {
      font-size: 0.85rem;
      color: rgba(253,252,250,0.45);
      line-height: 1.7;
      padding: 1rem 0;
      border-top: 0.5px solid rgba(255,255,255,0.06);
      margin-top: 0.5rem;
    }
    & .witness-note a { color: rgba(175,169,236,0.7); text-decoration: underline; text-underline-offset: 2px; }
    & .tier-note {
      font-size: 0.72rem;
      color: rgba(253,252,250,0.4);
      font-style: italic;
    }
    & .sponsored-note {
      background: rgba(175,169,236,0.07);
      border-left: 2px solid var(--edu-violet);
      padding: 1rem 1.25rem;
      font-size: 0.85rem;
      color: rgba(253,252,250,0.7);
      line-height: 1.65;
      border-radius: 0 6px 6px 0;
    }
    & .sponsored-note a { color: var(--edu-violet); text-decoration: underline; }

    /* THREE DOORS: Beat 4 */
    & .three-doors {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
      margin: 2.5rem 0;
    }
    & .door-card {
      background: var(--edu-void2);
      border: 0.5px solid var(--edu-border);
      border-radius: 3px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      transition: border-color 0.2s, background 0.2s;
    }
    & .door-card:hover {
      border-color: rgba(180,143,224,0.4);
      background: rgba(107,63,160,0.04);
    }
    & .door-card--featured {
      border-color: rgba(107,63,160,0.45);
      background: rgba(107,63,160,0.07);
    }
    & .door-emoji {
      font-size: 1.75rem;
      line-height: 1;
    }
    & .door-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.25rem;
      font-weight: 500;
      color: var(--edu-cream);
      margin-bottom: 0;
    }
    & .door-card p {
      font-size: 1rem;
      color: rgba(253,252,250,0.78);
      line-height: 1.75;
      flex: 1;
      max-width: 100%;
      margin: 0;
    }
    & .door-cta {
      align-self: flex-start;
      margin-top: 0.25rem;
    }
    & .door-highlight {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--edu-lavender);
      margin-top: 0.5rem;
