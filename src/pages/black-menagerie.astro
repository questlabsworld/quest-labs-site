---
import Layout from '../layouts/Layout.astro';
import ViolaSays from '../components/ViolaSays.astro';
const showSample = false;
---

<Layout
  title="The Black Menagerie · Quest Labs"
  description="The Black Menagerie Conversation Deck: a card game where you speak through one of five animals, step into real future scenarios, and discover how many futures one moment holds. Pre-sale is open."
  ogImage="/images/og/black-menagerie-preview.jpg"
>

<div class="bm-page">

  <div class="bm-hero">
    <div class="bm-eyebrow">Quest Labs · The Conversation Deck · Pre-sale is open</div>
    <h1 class="bm-title">The Black<br>Menagerie</h1>
    <p class="bm-sub"><span class="bm-accent">Five animals. One moment. Many futures.<br>Which voice will you bring?</span></p>
    <p class="bm-sub bm-sub--mechanic">A card game where you speak through one of five animals, step into real future scenarios, and <span class="bm-highlight">discover how many futures one moment holds.</span></p>
    <p class="bm-sub bm-sub--season">A new season. A new perspective.</p>
    <div class="cta-group bm-hero-ctas">
      <a href="/black-menagerie/play" class="cta-primary">Draw a card</a>
      <a href="#presale" class="cta-secondary">See the pre-sale</a>
      <a href="https://lu.ma/questlabs" class="cta-secondary" target="_blank" rel="noopener noreferrer">Find the next game night</a>
    </div>
    <div class="bm-badge">Pre-orders close December 31 · Ships by February 6, 2027</div>
  </div>

  <div class="bm-creatures">
    <div class="bm-section-label">The Five Archetypes</div>
    <h2 class="bm-section-heading">Meet the Black Menagerie</h2>
    <p class="bm-decolonial">Sardar &amp; Sweeney (2016) gave us the Menagerie of Postnormal Potentialities.<br>The Black Menagerie extends it with a decolonial feminist lens and puts it in your hands.<br>Three creatures became five.<br>Postnormal futures scholarship became a game you can play.</p>
    <p class="bm-section-sub">Each creature holds a different relationship with uncertainty, emergence, and what wants to be born.</p>
    <p class="bm-section-sub bm-section-sub--mirror">You will recognize yourself in them.<br>You will grow into the others.</p>

    <div class="bm-grid">
      <div class="bm-card">
        <img src="/images/cards/black-swan-card.jpg" alt="Black Swan card from the Black Menagerie Conversation Deck" class="bm-img" loading="lazy" width="484" height="660" />
      </div>
      <div class="bm-card">
        <img src="/images/cards/black-elephant-card.jpg" alt="Black Elephant card from the Black Menagerie Conversation Deck" class="bm-img" loading="lazy" width="484" height="660" />
      </div>
      <div class="bm-card">
        <img src="/images/cards/black-jellyfish-card.jpg" alt="Black Jellyfish card from the Black Menagerie Conversation Deck" class="bm-img" loading="lazy" width="484" height="660" />
      </div>
      <div class="bm-card">
        <img src="/images/cards/black-marsh-turtle-card.jpg" alt="Black Marsh Turtle card from the Black Menagerie Conversation Deck" class="bm-img" loading="lazy" width="484" height="660" />
      </div>
      <div class="bm-card">
        <img src="/images/cards/black-sheep-card.jpg" alt="Black Sheep card from the Black Menagerie Conversation Deck" class="bm-img" loading="lazy" width="484" height="660" />
      </div>
    </div>
  </div>

  {showSample && (
  <div class="bm-play">
    <div class="bm-section-label">A look inside the deck</div>
    <h2 class="bm-section-heading">Pick an animal</h2>
    <p class="bm-section-sub">Which voice will you bring?</p>

    <div class="bm-sample">
      <div class="bm-tcard bm-tcard--animal">
        <span class="bm-tkind">Animal</span>
        <img src="/images/creatures/black-elephant.png" alt="" class="bm-timg" loading="lazy" width="299" height="284" />
        <span class="bm-tname">Black Elephant</span>
        <span class="bm-ttag">the truth in the room</span>
        <span class="bm-tq">What's obvious here? Who gains from nobody saying it?</span>
        <span class="bm-tmeta"><b>Gift</b> naming the unspoken<br><b>Risk</b> paralysis of everyone-knew</span>
        <span class="bm-tmeta"><b>Would you rather</b> trust what a room already agrees on, or what only you can see?</span>
      </div>

      <div class="bm-tcard bm-tcard--cond">
        <span class="bm-tkind">World</span>
        <span class="bm-tname">Does something break?</span>
        <span class="bm-tpartner">Collapse</span>
      </div>

      <div class="bm-tcard bm-tcard--scen">
        <span class="bm-tkind">You are here</span>
        <span class="bm-tscen">Water is rationed by household now. A neighbor knocks and asks to share your quota this week.</span>
        <span class="bm-tsector">Political</span>
      </div>
      <div class="bm-tcard bm-tcard--scen">
        <span class="bm-tkind">You are here</span>
        <span class="bm-tscen">Your workplace moved to a four-day week. The pay stayed the same. Fridays belong to you now.</span>
        <span class="bm-tsector">Economic</span>
      </div>
      <div class="bm-tcard bm-tcard--scen">
        <span class="bm-tkind">You are here</span>
        <span class="bm-tscen">Your street closes to cars every Sunday now. Kids play where the traffic was. Neighbors you never met run a tool library from an old parking spot.</span>
        <span class="bm-tsector">Social</span>
      </div>
      <div class="bm-tcard bm-tcard--wild">
        <span class="bm-tkind">Write Your Own</span>
        <span class="bm-trule">This round, the table writes the scenario. Stuck? Something that changed on your street this year.</span>
      </div>
    </div>
    <p class="bm-sample-note">Sample cards. Final art and copy will change before print.</p>
  </div>
  )}

  <div class="bm-editions">
    <div class="bm-section-label">The Decks</div>
    <div class="bm-editions-grid">
      <div class="bm-edition">
        <div class="bm-edition-status">Pre-sale now</div>
        <h3>The Conversation Deck</h3>
        <p>54 cards: five animals, four worlds, 36 scenarios drawn from real-world signals, and cards to write your own. One rule: go to a world nobody picked. Play solo, with up to five, or more in teams, in about 45 minutes. No winners, no right answers. You win when your table sees the moment more clearly than when you sat down.</p>
      </div>
    </div>
    <details class="ql-fold bm-later-fold">
      <summary><span class="ql-fold__title">Coming later</span></summary>
      <div class="bm-editions-grid bm-later-grid">
      <div class="bm-edition bm-edition--later">
        <div class="bm-edition-status">Coming later</div>
        <h3>The Game</h3>
        <p>A collective world-building game, with Conditions and signature moves. The whole table builds one future together, and every voice changes where it lands.</p>
        <p>Curious, or concerned, about what future is coming for you and your beloveds? Come play with different ideas and help us design it. Every game night is part of the R&amp;D.</p>
      </div>
      <div class="bm-edition bm-edition--later">
        <div class="bm-edition-status">Coming later</div>
        <h3>Educator Deck</h3>
        <p>Adapted for classroom and staffroom use. The same five animals, designed for facilitation in educational contexts. Built alongside Futures Literacies in Praxis.</p>
      </div>
      </div>
    </details>
  </div>

  <div class="bm-presale" id="presale">
    <div class="bm-section-label">Pre-sale is open until December 31 · Bring in the new season</div>
    <h2 class="bm-section-heading">Choose your Menagerie</h2>
    <p class="bm-presale-lede">A card, a board, a box. More packs of signals and whispers of wisdom on the way.</p>
    <ViolaSays>
      <p>Want to try it at your kitchen table? Start with the Starter.</p>
      <p>Want a box you keep on the shelf? Deluxe.</p>
      <p>Want to help build The Game with us? Full Menagerie.</p>
    </ViolaSays>
    <div class="bm-tiers">
      <div class="bm-tier">
        <div class="bm-tier-img bm-tier-img--digital">
          <div class="bm-screen"><img src="/images/black-menagerie/card-jellyfish.png" alt="Black Jellyfish card shown on a screen" loading="lazy" width="825" height="1125" /></div>
        </div>
        <div class="bm-tier-body">
          <h3>digital starter</h3>
          <div class="bm-price">$28.88</div>
          <div class="bm-was">2026 pre-sale price. Goes up in 2027.</div>
          <p>The Conversation Deck as digital files. Print at home or play on screen.</p>
          <div class="bm-when">Delivered soon</div>
          <div class="bm-buy">
            <a href="https://buy.stripe.com/cNieV75PZ3b5dIh0qr3wQ09" class="cta-primary" target="_blank" rel="noopener noreferrer">Buy · digital files</a>
          </div>
        </div>
      </div>
      <div class="bm-tier">
        <div class="bm-tier-img"><img src="/images/black-menagerie/mockup-starter.png" alt="Poker-size Black Menagerie cards with a tuck box" loading="lazy" width="720" height="900" /></div>
        <div class="bm-tier-body">
          <h3>starter kit</h3>
          <div class="bm-price">$38.88</div>
          <div class="bm-was">2026 pre-sale price. Goes up in 2027.</div>
          <p>54 poker-size cards in a tuck box: 5 animals, 4 worlds, 36 scenarios. Digital files free.</p>
          <div class="bm-when">Ships by February 6, 2027</div>
          <div class="bm-buy">
            <a href="https://buy.stripe.com/14A28l6U312X33D7ST3wQ03" class="cta-primary" target="_blank" rel="noopener noreferrer">Buy · ship to US</a>
            <a href="https://buy.stripe.com/28E14h0vFdPJ33D8WX3wQ04" class="cta-secondary" target="_blank" rel="noopener noreferrer">Buy · ship to EU</a>
          </div>
        </div>
      </div>
      <div class="bm-tier bm-tier--featured">
        <div class="bm-tier-img"><img src="/images/black-menagerie/mockup-deluxe.png" alt="Tarot-size Black Menagerie cards with a hook box" loading="lazy" width="720" height="900" /></div>
        <div class="bm-tier-body">
          <span class="bm-tier-tag">A box you keep</span>
          <h3>deluxe</h3>
          <div class="bm-price">$68.88</div>
          <div class="bm-was">2026 pre-sale price. Goes up in 2027.</div>
          <p>Tarot-size cards in a hook box, plus an expansion pack of scenarios from across the diaspora.</p>
          <div class="bm-when">Ships by February 6, 2027</div>
          <div class="bm-buy">
            <a href="https://buy.stripe.com/aFa4gt92bh1V0Vv8WX3wQ05" class="cta-primary" target="_blank" rel="noopener noreferrer">Buy · ship to US</a>
            <a href="https://buy.stripe.com/9B69ANcenbHB33D2yz3wQ06" class="cta-secondary" target="_blank" rel="noopener noreferrer">Buy · ship to EU</a>
          </div>
        </div>
      </div>
      <div class="bm-tier">
        <div class="bm-tier-img"><img src="/images/black-menagerie/mockup-full.png" alt="The Black Menagerie game board, game box and cards" loading="lazy" width="720" height="900" /></div>
        <div class="bm-tier-body">
          <h3>full menagerie</h3>
          <div class="bm-price">$98.88</div>
          <div class="bm-was">2026 pre-sale price. Goes up in 2027.</div>
          <p>The Deluxe kit now, plus The Game (a card, a board, a box) when it ships in April 2027.</p>
          <p>Come play and help us design it.</p>
          <div class="bm-when">Deck by February 6, 2027 · Game April 2027</div>
          <div class="bm-buy">
            <a href="https://buy.stripe.com/aFa8wJ3HRaDx47Hfll3wQ07" class="cta-primary" target="_blank" rel="noopener noreferrer">Buy · ship to US</a>
            <a href="https://buy.stripe.com/3cIcMZ5PZ4f9bA97ST3wQ08" class="cta-secondary" target="_blank" rel="noopener noreferrer">Buy · ship to EU</a>
          </div>
        </div>
      </div>
    </div>
    <p class="bm-sample-note">Have a promo code? Enter it at checkout.</p>
  </div>

  <div class="bm-lives">
    <div class="bm-section-label">Where It Lives Now</div>
    <h2 class="bm-section-heading">Already in the Room</h2>
    <p class="bm-lives-text">The Black Menagerie debuted at the <strong>2025 International Healing-Centered Education Conference</strong>. It is a navigational lens inside every FLIP crew and Sandbox Session. It has been playtested at game nights in Berlin. The deck ships soon, and the creatures are already in the room.</p>
    <p class="bm-lives-text bm-lives-text--cta">Come play a game night.</p>
    <div class="cta-group" style="justify-content:center; margin-top:2rem;">
      <a href="https://lu.ma/questlabs" class="cta-primary" target="_blank" rel="noopener noreferrer">Find a game night on Luma</a>
      <a href="/program" class="cta-secondary">Explore The Program</a>
    </div>
  </div>

  <div class="page-bridge" style="max-width:860px; margin-left:auto; margin-right:auto; padding-left:2.5rem; padding-right:2.5rem;">
    <p>Already in the ecosystem?</p>
    <a href="/educators" class="bridge-link">Educators: the creatures are your navigational lens in Futures Literacies in Praxis</a>
    <a href="/foundations" class="bridge-link" style="margin-top:0.5rem;">See the theoretical lineage behind the archetypes</a>
  </div>

</div>

<footer>
  <div class="footer-inner">
    <div>
      <div class="footer-logo">Quest Labs</div>
      <div class="footer-tagline">A Living Lab for Futures Literacies</div>
    </div>
    <ul class="footer-links">
      <li><a href="/seed">Seed our becoming</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
  </div>
  <div class="footer-anchor">
    Not sure where to start?
    <a href="https://lu.ma/questlabs">Find a free Sandbox Session →</a>
  </div>
  <div class="footer-copy">2026 Quest Labs · Makēda · All futures reserved · Berlin &amp; Beyond</div>
</footer>

</Layout>

<style>
  .bm-page {
    --bm-violet: #6B3FA0;
    --bm-violet-mid: #8B5CC8;
    --bm-violet-light: #B48FE0;
    --bm-lavender: #C4A8E8;
    padding-top: 1rem;
  }

  .bm-hero { text-align:center; padding:6rem 2rem 4rem; }
  .bm-eyebrow { font-family:'Space Mono',monospace; font-size:0.75rem; letter-spacing:0.3em; text-transform:uppercase; color:var(--bm-violet-light); margin-bottom:1.25rem; }
  .bm-title { font-family:'Special Elite','Courier New',monospace; font-weight:400; font-size:clamp(2.8rem,6.5vw,4.8rem); letter-spacing:0.02em; color:var(--bm-lavender); line-height:1.05; margin-bottom:1.25rem; }
  .bm-sub { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:clamp(1.2rem,2.5vw,1.6rem); color:var(--text-dim); max-width:620px; margin:0 auto 1.5rem; line-height:1.6; }
  .bm-badge { display:inline-block; font-family:'Space Mono',monospace; font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--bm-violet-light); border:0.5px solid rgba(180,143,224,0.4); padding:0.4rem 1rem; border-radius:2px; margin-top:0.5rem; }

  .bm-creatures, .bm-editions, .bm-lives { max-width:1060px; margin:0 auto; padding:4rem 2.5rem; border-top:0.5px solid var(--border-dim); }
  .bm-section-label { font-family:'Space Mono',monospace; font-size:0.75rem; letter-spacing:0.25em; text-transform:uppercase; color:var(--bm-violet-light); margin-bottom:0.75rem; }
  .bm-section-heading { font-family:'Cormorant Garamond',serif; font-size:clamp(1.8rem,4vw,3rem); font-weight:500; color:var(--text); margin-bottom:1rem; }
  .bm-decolonial { font-family:'Cormorant Garamond',serif; font-size:1.05rem; color:var(--bm-violet-light); font-style:italic; line-height:1.7; margin-bottom:1.25rem; max-width:700px; border-left:2px solid rgba(180,143,224,0.35); padding-left:1.25rem; }
  .bm-section-sub { color:var(--text-dim); font-size:1rem; line-height:1.8; max-width:680px; margin-bottom:2.5rem; }

  .bm-sub--mechanic {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    margin-top: 0.75rem;
  }

  .bm-accent {
    background: linear-gradient(135deg, #B48FE0, #8B5CC8, #C4A8E8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: italic;
  }
  .bm-highlight {
    color: #C4A8E8;
    font-style: italic;
    font-weight: 600;
  }
  .bm-section-sub--mirror {
    font-style: italic;
    color: rgba(240, 236, 248, 0.75);
    font-size: 1.05rem;
    margin-top: 0;
  }
  .bm-lives-text--cta {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.15rem;
    color: var(--bm-lavender);
    margin-top: 1rem;
  }

  .bm-grid { display:flex; flex-wrap:wrap; justify-content:center; gap:1.5rem; }
  .bm-card { flex:0 1 calc((100% - 3rem) / 3); min-width:0; text-align:center; }
  .bm-img { width:100%; height:auto; display:block; border-radius:10px; box-shadow:0 10px 30px rgba(0,0,0,0.45); }
  .bm-card-link { display:block; border-radius:10px; transition:transform 0.2s ease; }
  .bm-card-link:hover { transform:translateY(-4px); }


  .bm-editions-grid { display:grid; grid-template-columns:minmax(0,1fr); gap:1.5rem; margin-top:1.5rem; }
  .bm-edition { background:rgba(107,63,160,0.05); border:0.5px solid rgba(107,63,160,0.2); border-radius:4px; padding:1.75rem; }
  .bm-edition h3 { font-family:'Cormorant Garamond',serif; font-size:1.3rem; font-weight:500; color:var(--bm-lavender); margin-bottom:0.75rem; }
  .bm-edition p { color:var(--text-dim); font-size:0.9rem; line-height:1.7; }

  .bm-lives { text-align:center; }
  .bm-lives-text { color:var(--text-dim); font-size:1rem; line-height:1.8; max-width:640px; margin:0 auto; }


  .bm-sub--season { font-size:clamp(1rem,2vw,1.2rem); color:var(--bm-lavender); }
  .bm-hero-ctas { justify-content:center; margin:1.5rem 0 1rem; }

  .bm-play, .bm-presale { max-width:1060px; margin:0 auto; padding:4rem 2.5rem; border-top:0.5px solid var(--border-dim); }
  .bm-sample { display:flex; gap:1rem; overflow-x:auto; padding:0.5rem 0 1.25rem; scroll-snap-type:x mandatory; }
  .bm-tcard { flex:none; width:200px; min-height:345px; border-radius:10px; padding:1rem; display:flex; flex-direction:column; gap:0.5rem; scroll-snap-align:start; font-size:0.85rem; line-height:1.45; position:relative; }
  .bm-tkind { font-family:'Space Mono',monospace; font-size:0.65rem; letter-spacing:0.18em; text-transform:uppercase; opacity:0.75; }
  .bm-tname { font-family:'Cormorant Garamond',serif; font-size:1.4rem; font-weight:500; line-height:1.1; }
  .bm-ttag { font-style:italic; color:var(--bm-violet-light); }
  .bm-tq { font-style:italic; }
  .bm-tmeta { font-size:0.75rem; color:var(--text-dim); }
  .bm-tmeta b { color:var(--bm-lavender); font-weight:500; }
  .bm-timg { width:100%; height:80px; object-fit:contain; }
  .bm-trule { margin-top:auto; font-size:0.8rem; }
  .bm-tpartner { font-family:'Space Mono',monospace; font-size:0.65rem; letter-spacing:0.12em; text-transform:uppercase; opacity:0.7; }
  .bm-tcard--animal { background:rgba(107,63,160,0.12); border:1px solid rgba(180,143,224,0.5); color:var(--text); }
  .bm-tcard--cond { background:#efe4f7; color:#3a1f52; border:2px solid var(--bm-violet); }
  .bm-tcard--scen { background:#f6f2ea; color:#1c1b29; }
  .bm-tsector { margin-top:auto; align-self:flex-start; font-family:'Space Mono',monospace; font-size:0.65rem; letter-spacing:0.12em; text-transform:uppercase; background:#1c1b29; color:#f6f2ea; padding:0.15rem 0.45rem; border-radius:3px; }
  .bm-tscen { font-size:0.95rem; }
  .bm-tcard--wild { background:#d7a53b; color:#1c1b29; }
  .bm-sample-note { color:var(--text-faint); font-size:0.85rem; font-style:italic; margin-top:0.5rem; }

  .bm-edition-status { font-family:'Space Mono',monospace; font-size:0.7rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--bm-violet-light); margin-bottom:0.5rem; }
  .bm-edition--later { opacity:0.75; }

  .bm-tiers { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1rem; margin-top:1.5rem; }
  .bm-buy { display:flex; flex-direction:column; gap:0.5rem; margin-top:1rem; }
  .bm-buy a { text-align:center; }
  .bm-presale-lede { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:1.3rem; color:var(--bm-lavender); line-height:1.5; margin-bottom:1rem; }
  .bm-tier { background:#0b0a10; border:1px solid #2c2440; border-radius:14px; overflow:hidden; display:flex; flex-direction:column; }
  .bm-tier--featured { border-color:#7a52c7; box-shadow:0 0 0 1px rgba(122,82,199,0.35), 0 20px 50px rgba(110,60,190,0.25); }
  .bm-tier-img { aspect-ratio:4/5; background:#000; overflow:hidden; }
  .bm-tier-img img { width:100%; height:100%; object-fit:cover; display:block; }
  .bm-tier-img--digital { position:relative; background:radial-gradient(ellipse at 50% 40%,#16121f,#000); }
  .bm-screen { position:absolute; left:50%; top:50%; width:62%; aspect-ratio:3/4.3; transform:translate(-50%,-52%) rotate(-4deg); border-radius:16px; background:#111; border:6px solid #222; box-shadow:0 0 0 1px rgba(201,166,255,0.27), 0 20px 40px rgba(110,60,190,0.35); overflow:hidden; }
  .bm-tier-body { padding:1.25rem 1.25rem 1.4rem; display:flex; flex-direction:column; gap:0.5rem; flex:1; }
  .bm-tier-tag { align-self:flex-start; font-family:'Space Mono',monospace; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#000; background:#c9a6ff; padding:0.2rem 0.5rem; border-radius:2px; }
  .bm-tier h3 { font-family:'Special Elite','Courier New',monospace; font-size:1.5rem; font-weight:400; color:#c9a6ff; text-transform:lowercase; }
  .bm-price { font-family:'Space Mono',monospace; font-size:1rem; color:var(--text); }
  .bm-tier p { color:var(--text-dim); font-size:0.9rem; line-height:1.6; }
  .bm-was { display:block; font-size:0.8rem; color:var(--text-faint); margin-top:0.25rem; }
  .bm-when { margin-top:auto; font-family:'Space Mono',monospace; font-size:0.7rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--bm-violet-light); }

  @media (max-width: 900px) {
    .bm-tiers { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
  @media (max-width: 768px) {
